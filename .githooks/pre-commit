#!/bin/sh
# Git pre-commit hook — versioned repository alignment gates
# 安装: git config core.hooksPath .githooks

REPO_ROOT="$(git rev-parse --show-toplevel)"

python3 "$REPO_ROOT/tools/check_gate_health.py" || exit $?

# 铁律 3: 文档同步
python3 "$REPO_ROOT/tools/check_doc_sync.py" --staged || exit $?

# 铁律 1.3: Ghidra 对齐注释门禁 — 全库检查 (--all)
# 全库门禁是项目"完整对齐 Ghidra"目标的根本保障。--staged 模式会漏掉
# 未触及定义行的历史违规，因此版本化 hook 固定使用 --all。
# 若提交被此门禁阻塞，必须修复违规函数（添加 // Ghidra: <file>:<line> <fn>
# 注释，并核实 4 类决定性语义），不得用 --no-verify 绕过。
python3 "$REPO_ROOT/tools/check_ghidra_annotations.py" --all || exit $?

# 机制 E 兜底: // Ghidra: 引用的 file:line 必须真实存在
# (运行时 PreToolUse hook 在 .zcode/align_gate.py 强制铁律 1.2"编辑前重读",
#  此处为 commit 时静态校验文件存在且行号未越界；函数定义起始行的精确映射
#  由逐函数账本审计负责，不能由范围检查冒充。
#  使用锁定 12.0.4 源码树做全库 strict 检查。)
python3 "$REPO_ROOT/tools/check_ghidra_refs.py" --all --strict || exit $?

exit 0
